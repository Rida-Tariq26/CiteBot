# CiteBot Environment Configuration

APP_NAME=CiteBot
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite+aiosqlite:///citebot.db

# LLM Provider: "mock" (offline zero-cost) or "openai" or "gemini"
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Admin Authentication
ADMIN_API_KEY=citebot-admin-secret-key-change-me

# Default Client Deployment Defaults
DEFAULT_DEPLOYMENT_ID=default
DEFAULT_CLIENT_NAME="Acme Corporation Knowledge Base"
DEFAULT_ACCENT_COLOR="#2563EB"
DEFAULT_CONFIDENCE_THRESHOLD=0.45
DEFAULT_REFUSAL_MESSAGE="I couldn't find this information in the uploaded documents. Please try rephrasing or refer directly to your organization's documentation."
DEFAULT_SYSTEM_TONE="precise, helpful, and professional"
